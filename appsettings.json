{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=attendance-register.db"
  },
  "SeedData": {
    "Enabled": false
  },
  "Institution": {
    "TimeZoneId": "Africa/Johannesburg"
  },
  "Attendance": {
    "WindowMinutes": 10,
    "LateAfterMinutes": 5,
    "QrTokenSeconds": 35
  },
  "AttendanceImport": {
    "MaximumFileBytes": 2000000,
    "MaximumRows": 5000,
    "HistoricalSessionStartHour": 9,
    "HistoricalSessionDurationMinutes": 60
  },
  "AttendanceReporting": {
    "AtRiskPercentage": 75
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
