@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}

<section class="error-state" aria-labelledby="error-title">
    <div class="error-state__icon" aria-hidden="true">!</div>
    <p class="eyebrow">Request interrupted</p>
    <h1 id="error-title">Something went wrong</h1>
    <p>Attendly could not complete that request. Your existing attendance data has not been changed.</p>
    <div class="error-state__actions">
        <a class="button button-primary" asp-page="/Dashboard">Return to overview</a>
        <button class="button button-secondary" type="button" onclick="history.back()">Go back</button>
    </div>
    @if (Model.ShowRequestId)
    {
        <p class="error-state__reference">Reference: <code>@Model.RequestId</code></p>
    }
</section>
