@page
@model AI_Workshop.Pages.Lecturer.Queries.IndexModel
@{ ViewData["Title"] = "Attendance queries"; }
<section class="page-heading"><div><span class="eyebrow">Review queue</span><h1>Attendance queries</h1><p>Investigate student disputes and make accountable corrections.</p></div><form method="get" class="query-filter"><label asp-for="Status">Status</label><select asp-for="Status" asp-items="Html.GetEnumSelectList<AI_Workshop.Models.Attendance.AttendanceQueryStatus>()" class="form-select" onchange="this.form.submit()"><option value="">All statuses</option></select></form></section>
<section class="history-summary query-summary"><article><span>Open queries</span><strong>@Model.OpenCount</strong></article><article><span>Shown</span><strong>@Model.Queries.Count</strong></article></section>
@if (Model.Queries.Count == 0) { <section class="empty-state panel"><div class="empty-icon">✓</div><h2>No matching queries</h2><p>There are no student attendance queries in this view.</p></section> }
else { <section class="panel data-panel"><div class="table-wrap"><table class="data-table"><thead><tr><th>Student</th><th>Lecture</th><th>Requested</th><th>Submitted</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var query in Model.Queries) { <tr><td><span class="primary-cell"><strong>@query.StudentName</strong><span>@query.StudentNumber</span></span></td><td><span class="primary-cell"><strong>@query.CourseCode</strong><span>@query.Topic · @query.LectureDate.ToString("d MMM yyyy")</span></span></td><td>@query.RequestedStatus</td><td>@query.SubmittedAt.ToString("d MMM · HH:mm")</td><td><span class="status-pill query-status-@query.Status.ToString().ToLowerInvariant()">@query.Status</span></td><td><a class="table-action" asp-page="Details" asp-route-id="@query.Id">Review →</a></td></tr> }</tbody></table></div></section> }
