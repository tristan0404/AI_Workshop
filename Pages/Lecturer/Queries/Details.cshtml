@page "{id:int}"
@using AI_Workshop.Models.Attendance
@model AI_Workshop.Pages.Lecturer.Queries.DetailsModel
@{ ViewData["Title"] = "Review attendance query"; var resolved = Model.Query.Status is AttendanceQueryStatus.Approved or AttendanceQueryStatus.Rejected; }
<section class="page-heading"><div><span class="eyebrow">@Model.Query.CourseCode · @Model.Query.LectureDate.ToString("d MMM yyyy")</span><h1>Review attendance query</h1><p>@Model.Query.StudentName · @Model.Query.StudentNumber</p></div><a class="button button-ghost" asp-page="Index">← Query queue</a></section>
@if (TempData["StatusMessage"] is string message) { <div class="alert-success">@message</div> }
<div asp-validation-summary="ModelOnly" class="alert-error"></div>
<section class="review-grid">
    <article class="panel query-review-panel"><div class="query-card-header"><div><span class="eyebrow">Student statement</span><h2>@Model.Query.Topic</h2></div><span class="status-pill query-status-@Model.Query.Status.ToString().ToLowerInvariant()">@Model.Query.Status</span></div><div class="status-comparison"><div><span>Current status</span><strong>@(Model.Query.CurrentStatus?.ToString() ?? "Not recorded")</strong></div><span>→</span><div><span>Requested status</span><strong>@Model.Query.RequestedStatus</strong></div></div><p class="query-explanation">@Model.Query.Explanation</p>@if (Model.Query.EvidenceFileName is not null) { <a class="button button-ghost" asp-page-handler="Evidence" asp-route-id="@Model.Query.Id">Download evidence · @Model.Query.EvidenceFileName</a> }</article>
    <aside class="panel decision-panel"><span class="eyebrow">Lecturer decision</span>@if (resolved) { <h2>@Model.Query.Status</h2><p>@Model.Query.LecturerResponse</p><small>Reviewed @Model.Query.ReviewedAt?.ToString("d MMM yyyy · HH:mm")</small> } else { @if (Model.Query.Status == AttendanceQueryStatus.Submitted) { <form method="post" asp-page-handler="StartReview"><button class="button button-ghost" type="submit">Mark under review</button></form> }<form method="post" class="decision-form"><div class="field-group"><label asp-for="DecisionReason">Response and reason</label><textarea asp-for="DecisionReason" class="form-control" rows="6" placeholder="Explain the decision for the student and audit trail."></textarea><span asp-validation-for="DecisionReason" class="field-error"></span></div><div class="decision-actions"><button class="button button-ghost danger-button" asp-page-handler="Reject" type="submit">Reject query</button><button class="button button-primary" asp-page-handler="Approve" type="submit">Approve and update</button></div></form> }</aside>
</section>
<section class="panel data-panel audit-panel"><div class="panel-header"><div><span class="eyebrow">Immutable history</span><h2>Attendance audit trail</h2></div></div>@if (Model.Audit.Count == 0) { <p class="inline-empty">No previous changes have been recorded.</p> } else { <div class="table-wrap"><table class="data-table"><thead><tr><th>Changed</th><th>Previous</th><th>New</th><th>Lecturer</th><th>Reason</th></tr></thead><tbody>@foreach (var log in Model.Audit) { <tr><td>@log.ChangedAt.ToString("d MMM yyyy · HH:mm")</td><td>@(log.PreviousStatus?.ToString() ?? "No record")</td><td>@log.NewStatus</td><td>@log.LecturerName</td><td>@log.Reason</td></tr> }</tbody></table></div> }</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
