@page
@model AI_Workshop.Pages.Lecturer.Attendance.IndexModel
@{ ViewData["Title"] = "Attendance"; }
<section class="page-heading"><div><span class="eyebrow">Lecture register</span><h1>Attendance sessions</h1><p>Open check-in, monitor the live register, or revisit a past lecture.</p></div></section>
@if (Model.Sessions.Count == 0) { <section class="empty-state panel"><div class="empty-icon"><svg viewBox="0 0 24 24"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM15 14h2v2h-2zM18 14h2v6h-6v-2"/></svg></div><h2>No lecture sessions yet</h2><p>Schedule a lecture from one of your courses before opening attendance.</p><a class="button button-primary" asp-page="/Lecturer/Courses/Index">View courses</a></section> }
else { <section class="panel data-panel"><div class="table-wrap"><table class="data-table"><thead><tr><th>Lecture</th><th>Date</th><th>Venue</th><th>Register</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var session in Model.Sessions) { <tr><td><span class="primary-cell"><strong>@session.CourseCode · @session.Topic</strong></span></td><td>@session.StartsAt.ToString("d MMM yyyy · HH:mm")</td><td>@(session.Venue ?? "TBC")</td><td>@session.CheckedIn / @session.Enrolled</td><td>@if (session.IsLive) { <span class="live-badge"><i></i>Live</span> } else { <span class="status-pill status-neutral">Closed</span> }</td><td><a class="table-action" asp-page="Live" asp-route-id="@session.Id">@(session.IsLive ? "View live →" : "Open →")</a></td></tr> }</tbody></table></div></section> }
