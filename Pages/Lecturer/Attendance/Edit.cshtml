@page
@model AI_Workshop.Pages.Lecturer.Attendance.EditModel
@{ ViewData["Title"] = "Edit attendance"; }
<section class="page-heading"><div><span class="eyebrow">@Model.Attendance.CourseCode · @Model.Attendance.StartsAt.ToString("d MMM yyyy")</span><h1>Edit attendance</h1><p>@Model.Attendance.StudentName · @Model.Attendance.StudentNumber · @Model.Attendance.Topic</p></div><a class="button button-ghost" asp-page="Live" asp-route-id="@Model.Attendance.SessionId">← Lecture register</a></section>
@if (TempData["StatusMessage"] is string message) { <div class="alert-success">@message</div> }
<section class="review-grid"><form method="post" class="panel form-panel"><div asp-validation-summary="ModelOnly" class="field-error"></div><span class="eyebrow">Manual correction</span><h2 class="form-title">Current: @(Model.Attendance.CurrentStatus?.ToString() ?? "Not recorded")</h2><div class="field-group"><label asp-for="Input.Status"></label><select asp-for="Input.Status" asp-items="Html.GetEnumSelectList<AI_Workshop.Models.Attendance.AttendanceStatus>()" class="form-select"></select></div><div class="field-group"><label asp-for="Input.Reason"></label><textarea asp-for="Input.Reason" class="form-control" rows="5" placeholder="Why is this attendance record changing?"></textarea><span asp-validation-for="Input.Reason" class="field-error"></span></div><button class="button button-primary" type="submit">Save correction</button></form><aside class="panel decision-panel"><span class="eyebrow">Accountability</span><h2>Every edit is recorded</h2><p>The previous status, new status, lecturer, timestamp, and reason remain in the audit trail.</p></aside></section>
<section class="panel data-panel audit-panel"><div class="panel-header"><div><span class="eyebrow">History</span><h2>Previous corrections</h2></div></div>@if (Model.Audit.Count == 0) { <p class="inline-empty">No manual changes have been recorded.</p> } else { <div class="table-wrap"><table class="data-table"><thead><tr><th>Changed</th><th>Previous</th><th>New</th><th>Lecturer</th><th>Reason</th></tr></thead><tbody>@foreach (var log in Model.Audit) { <tr><td>@log.ChangedAt.ToString("d MMM yyyy · HH:mm")</td><td>@(log.PreviousStatus?.ToString() ?? "No record")</td><td>@log.NewStatus</td><td>@log.LecturerName</td><td>@log.Reason</td></tr> }</tbody></table></div> }</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
