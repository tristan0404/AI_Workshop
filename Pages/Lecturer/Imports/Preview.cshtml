@page "{id:int}"
@using AI_Workshop.Models.Attendance
@model AI_Workshop.Pages.Lecturer.Imports.PreviewModel
@{ ViewData["Title"] = "Import preview"; }
<section class="page-heading"><div><span class="eyebrow">@Model.Batch.Course.Code · Historical records</span><h1>Review import</h1><p>@Model.Batch.FileName · @Model.Batch.SpreadsheetRowCount spreadsheet rows · @Model.Batch.RecordCount attendance records</p></div><a class="button button-ghost" asp-page="Index">← Back to imports</a></section>
@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage)) { <div class="alert-success">@Model.SuccessMessage</div> }
<div asp-validation-summary="ModelOnly" class="alert-error"></div>
<section class="history-summary import-summary"><article><span>New records</span><strong>@Model.CreateCount</strong></article><article><span>Updates</span><strong>@Model.UpdateCount</strong></article><article><span>Unchanged</span><strong>@Model.UnchangedCount</strong></article><article><span>Validation errors</span><strong>@Model.Batch.ErrorCount</strong></article></section>
@if (Model.Batch.Status == AttendanceImportStatus.Previewed && Model.Batch.ErrorCount == 0 && Model.StudentsToEnrollCount > 0) { <div class="import-enrolment-note"><strong>Automatic enrolment included</strong><span>@Model.StudentsToEnrollCount students will be enrolled in @Model.Batch.Course.Code. @Model.StudentsToCreateCount do not have accounts yet and will receive provisioned records that they can activate when registering.</span></div> }
@if (Model.Batch.Errors.Count > 0) {
<section class="panel data-panel import-errors"><div class="panel-header"><div><span class="eyebrow">Action required</span><h2>Fix these issues and upload again</h2></div></div><div class="table-wrap"><table class="data-table"><thead><tr><th>Row</th><th>Column</th><th>Issue</th></tr></thead><tbody>@foreach (var error in Model.Batch.Errors.OrderBy(x => x.SpreadsheetRow)) { <tr><td>@(error.SpreadsheetRow?.ToString() ?? "—")</td><td>@(error.Column ?? "File")</td><td>@error.Message</td></tr> }</tbody></table></div></section>
} else if (Model.Batch.Status == AttendanceImportStatus.Completed) {
<section class="panel attendance-ready import-complete"><div class="result-icon">✓</div><span class="eyebrow">Committed safely</span><h2>This register has been imported</h2><p>@Model.Batch.CreatedCount records were created and @Model.Batch.UpdatedCount were updated. This batch remains available in the audit trail.</p></section>
} else {
<section class="panel data-panel"><div class="panel-header"><div><span class="eyebrow">Step 2</span><h2>Proposed attendance changes</h2></div><form method="post" asp-page-handler="Confirm" asp-route-id="@Model.Batch.Id"><button class="button button-primary" type="submit">Confirm import</button></form></div><div class="table-wrap"><table class="data-table"><thead><tr><th>Student</th><th>Student number</th><th>Lecture date</th><th>Attendance</th><th>Change</th></tr></thead><tbody>@foreach (var item in Model.PreviewItems) { <tr><td><strong>@item.StudentName</strong></td><td>@item.StudentNumber</td><td>@item.LectureDate.ToString("d MMM yyyy")</td><td>@item.Status</td><td><span class="status-pill status-neutral">@item.Action</span></td></tr> }</tbody></table></div>@if (Model.Batch.RecordCount > Model.PreviewItems.Count) { <p class="inline-empty">Showing the first @Model.PreviewItems.Count of @Model.Batch.RecordCount records.</p> }</section>
}
