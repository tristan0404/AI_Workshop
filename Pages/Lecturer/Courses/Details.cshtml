@page "{id:int}"
@model AI_Workshop.Pages.Lecturer.Courses.DetailsModel
@inject AI_Workshop.Services.InstitutionTimeService InstitutionTime
@{ ViewData["Title"] = Model.Course.Code; }
<section class="page-heading"><div><span class="eyebrow">@Model.Course.AcademicYear · Semester @Model.Course.Semester</span><h1>@Model.Course.Code · @Model.Course.Name</h1><p>@(Model.Course.Description ?? "Course workspace for enrolments and lecture scheduling.")</p></div><a class="button button-ghost" asp-page="Edit" asp-route-id="@Model.Course.Id">Edit course</a></section>
@if (TempData["StatusMessage"] is string statusMessage) { <div class="alert-success" role="status">@statusMessage</div> }
<div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
<section class="course-workspace">
    <article class="panel data-panel">
        <div class="panel-header"><div><span class="eyebrow">Class list</span><h2>Enrolled students <span class="count-badge">@Model.Students.Count</span></h2></div></div>
        <form method="post" asp-page-handler="Enrol" class="inline-form"><input type="hidden" name="id" value="@Model.Course.Id"/><div class="field-group"><label asp-for="Enrolment.Identifier"></label><input asp-for="Enrolment.Identifier" class="form-control" placeholder="STU-2026-001 or student@email.com"/><span asp-validation-for="Enrolment.Identifier" class="field-error"></span></div><button class="button button-primary" type="submit">Enrol student</button></form>
        @if (Model.Students.Count == 0) { <div class="inline-empty">No students have been enrolled yet.</div> }
        else { <div class="table-wrap"><table class="data-table"><thead><tr><th>Student</th><th>Student number</th><th></th></tr></thead><tbody>@foreach (var student in Model.Students) { <tr><td><span class="primary-cell"><strong>@student.Name</strong><span>@student.Email</span></span></td><td>@student.StudentNumber</td><td><form method="post" asp-page-handler="RemoveStudent"><input type="hidden" name="id" value="@Model.Course.Id"/><input type="hidden" name="studentId" value="@student.Id"/><button class="table-action danger-action" type="submit">Remove</button></form></td></tr> }</tbody></table></div> }
    </article>
    <article class="panel data-panel">
        <div class="panel-header"><div><span class="eyebrow">Calendar</span><h2>Lecture sessions <span class="count-badge">@Model.Sessions.Count</span></h2></div></div>
        <form method="post" asp-page-handler="AddSession" class="session-form"><input type="hidden" name="id" value="@Model.Course.Id"/><div class="field-group form-span"><label asp-for="Session.Topic"></label><input asp-for="Session.Topic" class="form-control" placeholder="Lecture topic"/><span asp-validation-for="Session.Topic" class="field-error"></span></div><div class="field-group"><label asp-for="Session.StartsAt"></label><input asp-for="Session.StartsAt" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="form-control"/><span asp-validation-for="Session.StartsAt" class="field-error"></span></div><div class="field-group"><label asp-for="Session.EndsAt"></label><input asp-for="Session.EndsAt" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="form-control"/><span asp-validation-for="Session.EndsAt" class="field-error"></span></div><div class="field-group"><label asp-for="Session.Venue"></label><input asp-for="Session.Venue" class="form-control" placeholder="Room or online"/></div><button class="button button-primary session-submit" type="submit">Schedule lecture</button><small class="timezone-note form-span">Times use @Model.TimeZoneLabel.</small></form>
        @if (Model.Sessions.Count == 0) { <div class="inline-empty">No lectures have been scheduled yet.</div> }
        else { <div class="session-list">@foreach (var session in Model.Sessions) { var start = session.LocalStart(InstitutionTime); var end = session.LocalEnd(InstitutionTime); <div class="session-row @(session.Status == AI_Workshop.Models.Academic.LectureSessionStatus.Cancelled ? "is-cancelled" : "")"><div class="date-tile"><strong>@start.ToString("dd")</strong><span>@start.ToString("MMM")</span></div><div><strong>@session.Topic</strong><span>@start.ToString("ddd, HH:mm")–@end.ToString("HH:mm") · @(session.Venue ?? "Venue TBC")</span></div><span class="status-pill status-neutral">@session.Status</span>@if (session.Status == AI_Workshop.Models.Academic.LectureSessionStatus.Scheduled) { <div class="session-actions"><a class="table-action" asp-page="/Lecturer/Attendance/Live" asp-route-id="@session.Id">Attendance</a><form method="post" asp-page-handler="CancelSession"><input type="hidden" name="id" value="@Model.Course.Id"/><input type="hidden" name="sessionId" value="@session.Id"/><button class="table-action danger-action" type="submit">Cancel</button></form></div> }</div> }</div> }
    </article>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
