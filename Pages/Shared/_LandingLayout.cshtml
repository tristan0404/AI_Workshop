@using AI_Workshop.Models.Identity
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#E8EDDF" />
    <meta name="description" content="Attendly makes secure attendance simple for students and lecturers." />
    <title>@ViewData["Title"] · Attendly</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
</head>
<body class="landing-body">
    <header class="landing-header">
        <a class="landing-brand" asp-page="/Index" aria-label="Attendly home"><span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 3.75h12A2.25 2.25 0 0 1 20.25 6v12A2.25 2.25 0 0 1 18 20.25H6A2.25 2.25 0 0 1 3.75 18V6A2.25 2.25 0 0 1 6 3.75Z"/><path d="m8 12 2.6 2.6L16.5 8.7"/></svg></span><span>Attendly</span></a>
        <button class="landing-menu-button" type="button" data-landing-menu aria-expanded="false" aria-controls="landingNavigation"><span></span><span></span></button>
        <nav class="landing-nav" id="landingNavigation" aria-label="Landing page navigation">
            <a href="#how-it-works">How it works</a><a href="#for-everyone">Who it helps</a>
            @if (User.Identity?.IsAuthenticated == true) { <a class="landing-button landing-button-primary" asp-page="/Dashboard">Open dashboard</a> }
            else { <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="/Dashboard">Sign in</a><a class="landing-button landing-button-primary" asp-area="Identity" asp-page="/Account/Register">Create account</a> }
        </nav>
    </header>
    <main>@RenderBody()</main>
    <footer class="landing-footer">
        <a class="landing-brand" asp-page="/Index"><span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 3.75h12A2.25 2.25 0 0 1 20.25 6v12A2.25 2.25 0 0 1 18 20.25H6A2.25 2.25 0 0 1 3.75 18V6A2.25 2.25 0 0 1 6 3.75Z"/><path d="m8 12 2.6 2.6L16.5 8.7"/></svg></span><span>Attendly</span></a>
        <p>Attendance that earns everyone’s trust.</p><div><a asp-page="/Privacy">Privacy</a><span>© @DateTime.Now.Year Attendly</span></div>
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script><script src="~/js/landing.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
