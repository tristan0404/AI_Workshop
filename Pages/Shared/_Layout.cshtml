@using AI_Workshop.Models.Identity
@{
    var currentPath = Context.Request.Path.Value ?? string.Empty;
    var isOverview = currentPath.Equals("/Dashboard", StringComparison.OrdinalIgnoreCase);
    var isCourses = currentPath.Contains("/Courses", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#242423" />
    <title>@ViewData["Title"] · Attendly</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar" id="appSidebar">
            <a class="brand" asp-area="" asp-page="/Dashboard" aria-label="Attendly dashboard">
                <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 3.75h12A2.25 2.25 0 0 1 20.25 6v12A2.25 2.25 0 0 1 18 20.25H6A2.25 2.25 0 0 1 3.75 18V6A2.25 2.25 0 0 1 6 3.75Z"/><path d="m8 12 2.6 2.6L16.5 8.7"/></svg></span>
                <span>Attendly</span>
            </a>
            <nav class="side-nav" aria-label="Primary navigation">
                <p class="nav-section-label">Workspace</p>
                <a class="side-nav-link @(isOverview ? "active" : "")" asp-area="" asp-page="/Dashboard"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.75 11 12 4.25 20.25 11v8.25H15v-5.5H9v5.5H3.75V11Z"/></svg>Overview</a>
                @if (User.IsInRole(RoleNames.Lecturer)) { <a class="side-nav-link @(currentPath.Contains("/Lecturer/Attendance", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-page="/Lecturer/Attendance/Index"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M8 3v4M16 3v4M4 10h16"/></svg>Attendance</a> }
                else if (User.IsInRole(RoleNames.Student)) { <a class="side-nav-link @(currentPath.Contains("/Student/Attendance", StringComparison.OrdinalIgnoreCase) || currentPath.Contains("/Student/CheckIn", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-page="/Student/Attendance/Index"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M8 3v4M16 3v4M4 10h16"/></svg>Attendance</a> }
                @if (User.IsInRole(RoleNames.Lecturer))
                { <a class="side-nav-link @(isCourses ? "active" : "")" asp-page="/Lecturer/Courses/Index"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.5 19.5v-15h9v15M4 19.5h16M10 8h4M10 12h4"/></svg>Courses</a> }
                else if (User.IsInRole(RoleNames.Student))
                { <a class="side-nav-link @(isCourses ? "active" : "")" asp-page="/Student/Courses/Index"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.5 19.5v-15h9v15M4 19.5h16M10 8h4M10 12h4"/></svg>My courses</a> }
                else
                { <span class="side-nav-link is-disabled" aria-disabled="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.5 19.5v-15h9v15M4 19.5h16M10 8h4M10 12h4"/></svg>Courses</span> }
                <span class="side-nav-link is-disabled" aria-disabled="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19V9M10 19V5M16 19v-7M22 19H2"/></svg>Reports<span class="soon-badge">Soon</span></span>
            </nav>
            <div class="sidebar-footer">
                <a class="side-nav-link" asp-area="" asp-page="/Privacy"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.25"/><path d="M12 10.75v5M12 7.75v.25"/></svg>Privacy</a>
                <div class="phase-note"><span class="phase-dot"></span><div><strong>Attendance capture</strong><span>Phase 3 of 7</span></div></div>
            </div>
        </aside>
        <div class="app-main">
            <header class="topbar">
                <button class="icon-button menu-toggle" type="button" data-sidebar-toggle aria-label="Open navigation"><svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
                <div class="topbar-context"><span class="eyebrow">Attendance workspace</span><span class="term-label">2026 · Semester 1</span></div>
                <partial name="_LoginPartial" />
            </header>
            <main class="content" role="main">@RenderBody()</main>
        </div>
    </div>
    <div class="sidebar-backdrop" data-sidebar-toggle></div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
