@page "/Dashboard"
@model AI_Workshop.Pages.DashboardModel
@{ ViewData["Title"] = "Overview"; }
<section class="page-heading">
    <div><span class="eyebrow">@Model.TodayLabel</span><h1 class="text-type" data-text-type data-typing-speed="55" data-initial-delay="180" aria-label="@Model.Greeting"><span class="text-type__content" aria-hidden="true">@Model.Greeting</span><span class="text-type__cursor" aria-hidden="true">_</span></h1><p>@Model.Introduction</p></div>
    @if (Model.IsLecturer) { <a class="button button-primary" asp-page="/Lecturer/Courses/Create"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>New course</a> }
    else { <a class="button button-primary" asp-page="/Student/CheckIn"><svg viewBox="0 0 24 24"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM15 14h2v2h-2zM18 14h2v6h-6v-2"/></svg>Check in</a> }
</section>
<section class="metric-grid" aria-label="Workspace summary">
    <article class="metric-card metric-card-featured"><div class="metric-icon"><svg viewBox="0 0 24 24"><path d="M7.5 19.5v-15h9v15M4 19.5h16M10 8h4M10 12h4"/></svg></div><div><span>Active courses</span><strong>@Model.CourseCount</strong><small>@(Model.CourseCount == 0 ? "Create or join your first course" : "Current academic period")</small></div></article>
    <article class="metric-card"><div class="metric-icon"><svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M8 3v4M16 3v4M4 10h16"/></svg></div><div><span>Lecture sessions</span><strong>@Model.SessionCount</strong><small>@(Model.SessionCount == 0 ? "No sessions recorded yet" : "Scheduled and historical")</small></div></article>
    <article class="metric-card"><div class="metric-icon"><svg viewBox="0 0 24 24"><path d="M16 19v-1.5a3.5 3.5 0 0 0-3.5-3.5h-5A3.5 3.5 0 0 0 4 17.5V19M10 10a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM16 11a2.5 2.5 0 1 0 0-5M17 14a3 3 0 0 1 3 3v2"/></svg></div><div><span>@(Model.IsLecturer ? "Students" : "Enrolments")</span><strong>@Model.PeopleCount</strong><small>Across active courses</small></div></article>
    <article class="metric-card"><div class="metric-icon"><svg viewBox="0 0 24 24"><path d="M6 4h12a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-7l-4 3v-3H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"/></svg></div><div><span>Open queries</span><strong>0</strong><small>Nothing needs attention</small></div></article>
</section>
<section class="dashboard-grid"><article class="panel activity-panel"><div class="panel-header"><div><span class="eyebrow">Getting started</span><h2>Your workspace checklist</h2></div><span class="status-pill">@Model.ReadyStepCount of 4 ready</span></div><div class="checklist"><div class="checklist-row is-complete"><span class="check-icon"><svg viewBox="0 0 24 24"><path d="m7 12 3 3 7-7"/></svg></span><div><strong>Secure account foundation</strong><span>Individual authentication and roles are configured.</span></div><span>Complete</span></div><div class="checklist-row @(Model.CourseCount > 0 ? "is-complete" : "")"><span class="step-number">2</span><div><strong>@(Model.IsStudent ? "Join your first course" : "Create your first course")</strong><span>Set up the academic workspace.</span></div><span>@(Model.CourseCount > 0 ? "Complete" : "Phase 2")</span></div><div class="checklist-row @(Model.PeopleCount > 0 ? "is-complete" : "")"><span class="step-number">3</span><div><strong>@(Model.IsStudent ? "View your schedule" : "Add students")</strong><span>@(Model.IsStudent ? "Review scheduled lectures." : "Enrol the class list.")</span></div><span>@(Model.PeopleCount > 0 ? "Complete" : "Phase 2")</span></div><div class="checklist-row"><span class="step-number">4</span><div><strong>Run a check-in</strong><span>Open the rotating QR attendance window.</span></div><span>Phase 3</span></div></div></article>
    <aside class="panel account-panel"><div class="panel-header"><div><span class="eyebrow">System</span><h2>Workspace status</h2></div></div><dl class="system-list"><div><dt>Application</dt><dd><span class="status-dot"></span>Operational</dd></div><div><dt>Authentication</dt><dd>Individual accounts</dd></div><div><dt>Your access</dt><dd>@Model.RoleLabel</dd></div><div><dt>Data store</dt><dd>SQLite</dd></div></dl><div class="callout"><strong>Academic workspace ready.</strong><p>Courses, enrolments and lecture schedules are connected to your account.</p></div></aside>
</section>
