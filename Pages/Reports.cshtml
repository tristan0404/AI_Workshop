@page "/Reports"
@using System.Text.Json
@model AI_Workshop.Pages.ReportsModel
@{ ViewData["Title"] = "Reports"; var jsonOptions = new JsonSerializerOptions(JsonSerializerDefaults.Web); }
<section class="page-heading dashboard-heading">
    <div><span class="eyebrow">Attendance intelligence</span><h1>Reports</h1><p>@Model.Introduction</p></div>
    <a class="button button-secondary" asp-page="/Dashboard">Back to overview</a>
</section>
<section class="report-kpi-grid" aria-label="Attendance summary">
    <article class="report-kpi report-kpi-primary"><span class="report-kpi-icon"><svg viewBox="0 0 24 24"><path d="M4 19V9M10 19V5M16 19v-7M22 19H2"/></svg></span><div><strong>@Model.AttendanceRate.ToString("0.#")%</strong><span>@(Model.IsLecturer ? "Average attendance" : "Your attendance")</span><small>@(Model.SessionCount == 0 ? "Waiting for attendance data" : $"Across {Model.SessionCount} past lectures")</small></div><a asp-page="@(Model.IsLecturer ? "/Lecturer/Attendance/Index" : "/Student/Attendance/Index")">Open attendance records <span>→</span></a></article>
    <article class="report-kpi"><span class="report-kpi-icon"><svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M8 3v4M16 3v4M4 10h16"/></svg></span><div><strong>@Model.SessionCount</strong><span>Past lectures</span><small>Included in this report</small></div><a asp-page="@(Model.IsLecturer ? "/Lecturer/Attendance/Index" : "/Student/Attendance/Index")">View lecture history <span>→</span></a></article>
    <article class="report-kpi report-kpi-risk"><span class="report-kpi-icon"><svg viewBox="0 0 24 24"><path d="M12 4 3.5 19h17L12 4Z"/><path d="M12 9v4M12 16h.01"/></svg></span><div><strong>@Model.AtRiskCount</strong><span>@(Model.IsLecturer ? "Students at risk" : "Risk indicator")</span><small>Below @Model.AtRiskThreshold.ToString("0.#")% attendance</small></div><a asp-page="@(Model.IsLecturer ? "/Lecturer/Courses/Index" : "/Student/Attendance/Index")">Review attendance <span>→</span></a></article>
    <article class="report-kpi report-kpi-dark"><span class="report-kpi-icon"><svg viewBox="0 0 24 24"><path d="M5 5h14v10H9l-4 4V5Z"/><path d="M9 9h6M9 12h4"/></svg></span><div><strong>@Model.OpenQueryCount</strong><span>Open queries</span><small>@(Model.OpenQueryCount == 0 ? "Nothing needs attention" : "Awaiting a decision")</small></div><a asp-page="@(Model.IsLecturer ? "/Lecturer/Queries/Index" : "/Student/Attendance/Queries")">Open query centre <span>→</span></a></article>
</section>
<section class="analytics-grid" data-dashboard-charts>
    <article class="panel analytics-panel analytics-trend"><header class="analytics-header"><div><span class="eyebrow">Attendance momentum</span><h2>@(Model.IsLecturer ? "Lecture attendance trend" : "Your attendance trend")</h2></div><span class="chart-key"><i class="key-attended"></i>Attendance rate</span></header><div class="chart-stage" data-line-chart aria-label="Attendance rate trend"></div><script type="application/json" data-chart-data="line">@Html.Raw(JsonSerializer.Serialize(Model.Trend, jsonOptions))</script><table class="sr-only"><caption>Attendance trend data</caption><thead><tr><th>Lecture</th><th>Rate</th></tr></thead><tbody>@foreach (var point in Model.Trend) { <tr><td>@point.Label · @point.Detail</td><td>@point.Value%</td></tr> }</tbody></table></article>
    <article class="panel analytics-panel"><header class="analytics-header"><div><span class="eyebrow">Comparison</span><h2>@(Model.IsLecturer ? "Recent lectures" : "Attendance by course")</h2></div><div class="chart-legend"><span class="chart-key"><i class="key-attended"></i>Attended</span><span class="chart-key"><i class="key-missed"></i>Missed</span></div></header><div class="chart-stage" data-bar-chart aria-label="Attended and missed comparison"></div><script type="application/json" data-chart-data="bar">@Html.Raw(JsonSerializer.Serialize(Model.Bars, jsonOptions))</script></article>
    <article class="panel analytics-panel"><header class="analytics-header"><div><span class="eyebrow">Status mix</span><h2>Attendance breakdown</h2></div></header><div class="donut-layout"><div class="chart-stage donut-stage" data-donut-chart aria-label="Attendance status breakdown"></div><div class="donut-legend" data-donut-legend></div></div><script type="application/json" data-chart-data="donut">@Html.Raw(JsonSerializer.Serialize(Model.Donut, jsonOptions))</script></article>
    <article class="panel analytics-panel analytics-heatmap"><header class="analytics-header"><div><span class="eyebrow">Consistency map</span><h2>@(Model.IsLecturer ? "Daily attendance intensity" : "Your attendance calendar")</h2></div><span class="chart-key">Last 12 months</span></header><div class="heatmap-scroll"><div class="chart-stage heatmap-stage" data-heatmap-chart aria-label="Attendance heatmap"></div></div><div class="heatmap-legend"><span>Less</span><i data-level="0"></i><i data-level="1"></i><i data-level="2"></i><i data-level="3"></i><i data-level="4"></i><span>More</span></div><script type="application/json" data-chart-data="heatmap">@Html.Raw(JsonSerializer.Serialize(Model.Heatmap, jsonOptions))</script></article>
</section>
@section Scripts { <script src="~/js/dashboard-charts.js" asp-append-version="true"></script> }
