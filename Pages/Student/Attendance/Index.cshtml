@page
@using AI_Workshop.Models.Attendance
@model AI_Workshop.Pages.Student.Attendance.IndexModel
@{ ViewData["Title"] = "Attendance history"; }
<section class="page-heading"><div><span class="eyebrow">Your record</span><h1>Attendance history</h1><p>Review every lecture, inspect how attendance was captured, or query an incorrect record.</p></div><div class="heading-actions"><a class="button button-ghost" asp-page="Queries">My queries</a><a class="button button-primary" asp-page="/Student/CheckIn">Enter fallback code</a></div></section>
<section class="history-summary"><article><span>Recorded sessions</span><strong>@Model.Records.Count</strong></article><article><span>Present</span><strong>@Model.PresentCount</strong></article><article><span>Late</span><strong>@Model.LateCount</strong></article><form method="get"><label asp-for="CourseId">Filter by course</label><select asp-for="CourseId" asp-items="Model.Courses" class="form-select" onchange="this.form.submit()"><option value="">All courses</option></select></form></section>
@if (Model.Records.Count == 0) { <section class="empty-state panel"><div class="empty-icon"><svg viewBox="0 0 24 24"><path d="M5 12.5 9.2 17 19 7"/></svg></div><h2>No attendance records found</h2><p>Your successful QR and fallback-code check-ins will appear here.</p></section> }
else { <section class="panel data-panel"><div class="table-wrap"><table class="data-table"><thead><tr><th>Lecture</th><th>Date</th><th>Recorded</th><th>Source</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var record in Model.Records) { <tr><td><span class="primary-cell"><strong>@record.CourseCode</strong><span>@record.Topic</span></span></td><td>@record.LectureDate.ToString("d MMM yyyy · HH:mm")</td><td>@(record.CheckedInAt?.ToString("HH:mm") ?? "—")</td><td>@(record.Source?.ToString() ?? "Not recorded")</td><td>@if (record.Status is not null) { <span class="attendance-chip">@record.Status</span> } else { <span class="status-pill status-neutral">Not recorded</span> }</td><td>@if (record.QueryStatus is AttendanceQueryStatus.Submitted or AttendanceQueryStatus.UnderReview) { <span class="status-pill">Query @record.QueryStatus</span> } else { <a class="table-action" asp-page="Query" asp-route-sessionId="@record.SessionId">Query →</a> }</td></tr> }</tbody></table></div></section> }
