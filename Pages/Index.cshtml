@page
@model AI_Workshop.Pages.IndexModel
@{ Layout = "/Pages/Shared/_LandingLayout.cshtml"; ViewData["Title"] = "Modern attendance, made simple"; }
<section class="landing-hero">
    <div class="hero-copy"><span class="landing-kicker"><span></span>Built for modern classrooms</span><h1>Attendance that keeps everyone <em>in sync.</em></h1><p>Give lecturers a clear view of every session and students a trusted record of every check-in. All in one calm, secure workspace.</p>
        <div class="hero-actions">@if (User.Identity?.IsAuthenticated == true) { <a class="landing-button landing-button-dark" asp-page="/Dashboard">Open your dashboard <span>→</span></a> } else { <a class="landing-button landing-button-dark" asp-area="Identity" asp-page="/Account/Register">Get started <span>→</span></a><a class="text-link" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="/Dashboard">I already have an account</a> }</div>
        <div class="hero-proof"><span class="proof-avatars"><b>MN</b><b>TM</b><b>+</b></span><span><strong>One shared source of truth</strong> for every lecture.</span></div>
    </div>
    <div class="hero-visual" aria-label="Students learning together"><div class="hero-image-frame"><img src="~/images/landing/students.png" alt="Students learning together with books and notes" width="626" height="626" /></div><div class="floating-card floating-card-top"><span class="floating-icon">✓</span><div><strong>Checked in</strong><small>09:02 · ECO201</small></div></div><div class="floating-card floating-card-bottom"><span class="live-dot"></span><div><strong>84% present</strong><small>Live lecture status</small></div></div></div>
</section>
<section class="trust-strip" aria-label="Platform benefits"><span>Secure individual accounts</span><i></i><span>Fast QR check-in</span><i></i><span>Clear attendance history</span><i></i><span>Auditable corrections</span></section>
<div class="scroll-stack" data-scroll-stack>
<section class="landing-section intro-section scroll-stack-card" id="how-it-works" style="--stack-index: 0" data-scroll-stack-card><span class="section-label">How it works</span><h2>Less admin. More time for teaching and learning.</h2><p class="section-lead">A simple workflow that keeps attendance accurate without slowing down the start of a lecture.</p>
    <div class="steps-grid"><article><span>01</span><div class="step-icon"><svg viewBox="0 0 24 24"><path d="M7.5 19.5v-15h9v15M4 19.5h16M10 8h4M10 12h4"/></svg></div><h3>Set up the class</h3><p>Create a course, enrol students, and schedule the lecture.</p></article><article><span>02</span><div class="step-icon"><svg viewBox="0 0 24 24"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM15 14h2v2h-2zM18 14h2v6h-6v-2"/></svg></div><h3>Open check-in</h3><p>Display a secure rotating QR code when attendance begins.</p></article><article><span>03</span><div class="step-icon"><svg viewBox="0 0 24 24"><path d="M5 12.5 9.2 17 19 7"/></svg></div><h3>Stay informed</h3><p>Students see confirmation while lecturers receive a live overview.</p></article></div>
</section>
<section class="feature-band scroll-stack-card" style="--stack-index: 1" data-scroll-stack-card><div class="feature-image qr-feature"><img src="~/images/landing/qr-phone.jpg" alt="Mobile phone scanning a QR code" width="800" height="800" loading="lazy" /></div><div class="feature-copy"><span class="section-label">Designed for the moment</span><h2>Check in before the lecture gets going.</h2><p>A short-lived QR code links each signed-in student to the correct session. A fallback code keeps the experience inclusive when a camera is unavailable.</p><ul><li><span>✓</span>Authenticated student identity</li><li><span>✓</span>Time-limited session access</li><li><span>✓</span>Immediate confirmation</li></ul><span class="phase-tag">Secure QR attendance is ready</span></div></section>
<section class="landing-section audience-section scroll-stack-card" id="for-everyone" style="--stack-index: 2" data-scroll-stack-card><span class="section-label">One system, two clear experiences</span><h2>Purpose-built for both sides of the classroom.</h2>
    <div class="audience-grid"><article class="audience-card audience-lecturer"><div class="audience-image"><img src="~/images/landing/lecturer-dashboard.jpg" alt="Lecturer presenting to students" width="626" height="313" loading="lazy" /></div><div><span>For lecturers</span><h3>See the whole class at a glance.</h3><p>Manage courses, enrol students, schedule sessions, and build a reliable register.</p><a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="/Dashboard">Lecturer sign in →</a></div></article><article class="audience-card audience-student"><div><span>For students</span><h3>Keep your own trusted record.</h3><p>View courses, upcoming lectures, and a clear history of every successful check-in.</p><a asp-area="Identity" asp-page="/Account/Register">Create student account →</a></div><div class="mini-register" aria-hidden="true"><div><span>ECO201</span><b>Present</b></div><div><span>INF201</span><b>Upcoming</b></div><div><span>ACC101</span><b>Present</b></div></div></article></div>
</section>
</div>
<section class="landing-cta"><span class="section-label">Ready when you are</span><h2>Make every lecture count.</h2><p>Start with secure accounts, clear courses, and a schedule everyone can trust.</p><div>@if (User.Identity?.IsAuthenticated == true) { <a class="landing-button landing-button-primary" asp-page="/Dashboard">Open dashboard</a> } else { <a class="landing-button landing-button-primary" asp-area="Identity" asp-page="/Account/Register">Create your account</a><a class="landing-button landing-button-outline" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="/Dashboard">Sign in</a> }</div></section>
